ENVIRONMENT=production
SECRET_KEY=replace-with-at-least-32-random-bytes
AUTH_COOKIE_NAME=sovereign_session
AUTH_COOKIE_SECURE=true
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
DATABASE_URL=postgresql+psycopg://sovereign:change-me@postgres:5432/sovereign
OLLAMA_URL=http://127.0.0.1:11434
CORS_ORIGINS=https://sovereign.example.internal
TRUSTED_HOSTS=sovereign.example.internal,127.0.0.1
ENABLE_API_DOCS=false
MAX_UPLOAD_BYTES=26214400
MAX_PROMPT_CHARS=32000
RAG_TOP_K=4
RAG_MAX_CANDIDATE_CHUNKS=2000
CHAT_CONTEXT_CHARS=12000
CHAT_HISTORY_MESSAGE_CHARS=4000
CHAT_TEMPERATURE=0.2
CHAT_NUM_CTX=8192
REQUIRE_DATABASE_MIGRATIONS=true
# Keep disabled until execution runs inside a disposable, network-isolated container.
ENABLE_CODE_SANDBOX=false
