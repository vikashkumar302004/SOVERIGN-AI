ENVIRONMENT=production
SECRET_KEY=replace-with-at-least-32-random-bytes
AUTH_COOKIE_NAME=sovereign_session
AUTH_COOKIE_SECURE=true
OLLAMA_URL=http://127.0.0.1:11434
CORS_ORIGINS=https://sovereign.example.internal
MAX_UPLOAD_BYTES=26214400
# Keep disabled until execution runs inside a disposable, network-isolated container.
ENABLE_CODE_SANDBOX=false
